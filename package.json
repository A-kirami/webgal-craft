{
  "name": "webgal-craft",
  "private": true,
  "version": "1.0.0-beta.2",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite dev",
    "dev:android": "tauri android dev",
    "dev:android:open": "tauri android dev --open",
    "generate:protocol": "bun scripts/generate-editor-preview-protocol-rs.mjs",
    "generate:protocol:check": "bun scripts/generate-editor-preview-protocol-rs.mjs --check",
    "build": "tauri build",
    "build:web": "bun typecheck:app && bun typecheck:node && vite build",
    "build:android": "tauri android build",
    "build:android:debug": "tauri android build --debug",
    "build:android:arm64": "tauri android build --target aarch64 --apk --split-per-abi --ci",
    "preview:web": "vite preview",
    "tauri": "tauri",
    "typecheck": "bun generate:protocol:check && bun typecheck:app && bun typecheck:node && bun typecheck:test",
    "typecheck:app": "vue-tsc -p tsconfig.app.json",
    "typecheck:node": "vue-tsc -p tsconfig.node.json",
    "typecheck:test": "vue-tsc -p tsconfig.test.json",
    "test": "bun test:unit && bun test:browser && bun test:integration",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:coverage": "vitest run --project unit --coverage",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:integration": "playwright test --config integration/playwright.config.ts",
    "test:unit:watch": "vitest --project unit",
    "lint": "bun lint:js && bun lint:style && bun lint:i18n",
    "lint:fix": "bun lint:js:fix && bun lint:style:fix && bun lint:i18n:fix",
    "lint:js": "eslint '**/*.{js,jsx,ts,tsx,cjs,mjs,vue}'",
    "lint:js:fix": "eslint '**/*.{js,jsx,ts,tsx,cjs,mjs,vue}' --fix",
    "lint:style": "stylelint 'src/**/*.{css,vue}'",
    "lint:style:fix": "stylelint 'src/**/*.{css,vue}' --fix",
    "lint:i18n": "eslint 'src/locales/*.{json,json5,yaml,yml}'",
    "lint:i18n:fix": "eslint 'src/locales/*.{json,json5,yaml,yml}' --fix",
    "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "lint:rs:fix": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --fix --allow-dirty --allow-staged",
    "format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --all"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@lucide/vue": "^1.48.0",
    "@tanstack/vue-virtual": "^3.13.39",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-log": "^2.9.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "compare-versions": "^6.1.1",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.16",
    "driver.js": "^1.8.0",
    "lru-cache": "^11.5.3",
    "markdown-it": "^15.0.2",
    "mime": "^4.1.0",
    "monaco-editor": "~0.51.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.10.5",
    "sanitize-filename": "^1.6.4",
    "tailwind-merge": "^3.7.0",
    "vee-validate": "^5.0.0-beta.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "wavesurfer.js": "^8.0.1",
    "webgal-parser": "4.6.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.136",
    "@iconify-json/simple-icons": "^1.2.97",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-config": "^5.0.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.3.14",
    "@unocss/eslint-config": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue-macros/eslint-config": "^3.1.4",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "65.0.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "postcss-html": "^2.0.0",
    "postcss-nesting": "^14.0.2",
    "stylelint": "^17.15.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "unocss": "^66.10.5",
    "unocss-preset-animations": "^1.3.0",
    "unocss-preset-shadcn": "^1.0.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-info": "^1.3.2",
    "unplugin-turbo-console": "^2.3.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vue-meta-layouts": "^0.6.1",
    "vitest": "^5.0.2",
    "vitest-browser-vue": "^3.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-macros": "^3.1.4",
    "vue-tsc": "3.3.3"
  },
  "packageManager": "bun@1.3.14"
}
